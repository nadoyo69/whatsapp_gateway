# ==============================================================================
# WhatsApp Gateway configuration
#
# Copy this file to `.env` and replace EVERY value that starts with CHANGE_ME.
# The backend refuses to start while a required secret is missing or still a
# placeholder. Generate strong values with:
#
#   openssl rand -hex 32
#
# Never commit your real `.env` file.
# ==============================================================================

# Host ports, used only by the optional docker-compose.override.yml shown in the README.
# By default the containers publish no ports; your reverse proxy reaches them over npm_network.
BACKEND_PORT=3000
FRONTEND_PORT=8080

# Public URLs (informational; used by your reverse proxy setup)
CLIENT_URL=https://wa.example.com
FRONTEND_DOMAIN=wa.example.com
API_DOMAIN=wa-api.example.com

# PostgreSQL (reachable only inside the Docker network)
DB_HOST=wa-postgres
DB_PORT=5432
DB_NAME=wa_gateway_db
DB_USER=wa_admin
DB_PASSWORD=CHANGE_ME_postgres_password

# MongoDB (reachable only inside the Docker network)
MONGO_HOST=wa-mongo
MONGO_PORT=27017
MONGO_DB=wa_gateway_logs
MONGO_USER=wa_admin
MONGO_PASSWORD=CHANGE_ME_mongo_password

# Security
# JWT_SECRET must be at least 32 characters.
JWT_SECRET=CHANGE_ME_jwt_secret_at_least_32_characters
# Master API key created on first start (at least 24 characters).
DEFAULT_API_TOKEN=CHANGE_ME_master_api_key_at_least_24_chars

# Initial admin account, created only when the users table is empty (password: 8+ characters)
ADMIN_DEFAULT_USER=admin
ADMIN_DEFAULT_PASS=CHANGE_ME_admin_password
ADMIN_DEFAULT_EMAIL=admin@example.com

# Baileys log level (silent, warn, info, debug)
LOG_LEVEL=silent
