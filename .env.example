# ==============================================================================
# WhatsApp Gateway Configuration
# Domain: whatsapp.nexforgex.my.id (Frontend) & whatsapp-api.nexforgex.my.id (Backend)
# ==============================================================================

# System Ports (Exposed to Host / Nginx Proxy Manager)
BACKEND_PORT=3000
FRONTEND_PORT=8080

# Domain & CORS Configuration
CLIENT_URL=https://whatsapp.nexforgex.my.id,*
FRONTEND_DOMAIN=whatsapp.nexforgex.my.id
API_DOMAIN=whatsapp-api.nexforgex.my.id

# PostgreSQL Configuration (Hanya diakses internal Docker via wa_network)
DB_HOST=wa-postgres
DB_PORT=5432
DB_NAME=wa_gateway_db
DB_USER=wa_admin
DB_PASSWORD=wa_secret_123_change_this_in_production

# MongoDB Configuration (Hanya diakses internal Docker via wa_network)
MONGO_HOST=wa-mongo
MONGO_PORT=27017
MONGO_DB=wa_gateway_logs
MONGO_USER=wa_admin
MONGO_PASSWORD=wa_secret_123_change_this_in_production

# Security & JWT
JWT_SECRET=wa_super_secret_jwt_key_2026_change_this_in_production
DEFAULT_API_TOKEN=wa_secret_token_default_key_2026

# Default Initial Admin Credentials
ADMIN_DEFAULT_USER=admin
ADMIN_DEFAULT_PASS=admin123
ADMIN_DEFAULT_EMAIL=admin@whatsapp.nexforgex.my.id

# Baileys WhatsApp Engine Log Level (silent, warn, info, debug)
LOG_LEVEL=silent
