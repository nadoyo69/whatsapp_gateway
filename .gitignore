# ==========================================
# NadoyoGateway .gitignore
# ==========================================

# 1. Environment & Secret Credentials
.env
.env.local
.env.*.local
*.env
!.env.example

# 2. WhatsApp Session Keys & Auth State (IMPORTANT)
sessions/
backend/sessions/
*/sessions/
*.session

# 3. Temporary Uploads & Media Files
uploads/
backend/uploads/
*/uploads/

# 4. Database Data & Docker Volume Bindings
data/
pg_data/
mongo_data/
sessions_data/
uploads_data/
*.db
*.sqlite
*.sqlite3

# 5. Node Dependencies & Package Managers
node_modules/
backend/node_modules/
frontend/node_modules/
*/node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# 6. Production Builds & Distributables
dist/
frontend/dist/
*/dist/
build/
.output/

# 7. Editor & IDE Caches
.vscode/
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# 8. OS Generated Files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# 9. Logs & Runtime Files
logs/
*.log
